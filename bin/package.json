{
  "name": "node-ts-generator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "clean": "rimraf dist",
    "checkts": "tsc --noEmit --project tsconfig.json",
    "typecheck": "pnpm checkts",
    "build:dev": "pnpm clean && tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "build": "pnpm lint && pnpm checkts && pnpm clean && webpack --config webpack.config.js --mode production",
    "dev": "tsx watch index.ts",
    "dev:inspect": "tsx watch --inspect index.ts",
    "install:clean": "rimraf node_modules package-lock.json pnpm-lock.yaml && pnpm install",
    "lint": "eslint src pre-start index.ts",
    "lint:fix": "eslint src pre-start index.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"pre-start/**/*.ts\" index.ts tsconfig*.json package.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"pre-start/**/*.ts\" index.ts tsconfig*.json package.json",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
